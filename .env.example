# URL publique de la page (code QR, partage, SEO).
# Laisser VIDE : sur Vercel, le domaine de production est détecté automatiquement ; ailleurs,
# siteUrl (src/config/links.config.ts) sert de repli, avec un avertissement au build.
# N’inscrire https://aeebm.ca qu’une fois le domaine repris auprès de l’ancien prestataire (fiche, section 08).
NEXT_PUBLIC_SITE_URL=

# Infolettre Mailchimp (facultatif en développement : l’inscription y est simulée)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
